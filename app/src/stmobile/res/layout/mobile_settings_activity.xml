<?xml version="1.0" encoding="utf-8"?>
<!-- The phone Settings screen: a back bar over the settings list. Opaque background: the
     window itself is translucent so the screen underneath is only paused (see MobileSettingsActivity). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/mobile_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/mobile_toolbar_height"
        android:paddingTop="@dimen/mobile_toolbar_padding_top"
        android:paddingBottom="@dimen/mobile_toolbar_padding_bottom"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/mobile_primary">

        <ImageButton
            android:id="@+id/btn_back"
            style="@style/Widget.SmarterTube.Mobile.ToolbarBackButton" />

        <TextView
            style="@style/Widget.SmarterTube.Mobile.ToolbarTitle"
            android:text="@string/header_settings" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/settings_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />
</LinearLayout>
