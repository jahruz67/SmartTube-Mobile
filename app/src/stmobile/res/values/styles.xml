<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Override the theme's loading-spinner mode for saved watch progress. -->
    <style name="Widget.SmarterTube.Mobile.WatchedProgress" parent="android:Widget.ProgressBar.Horizontal">
        <item name="android:indeterminate">false</item>
        <item name="android:indeterminateOnly">false</item>
        <item name="android:max">100</item>
        <item name="android:progressDrawable">@drawable/mobile_watched_progress</item>
        <item name="android:contentDescription">@null</item>
    </style>

    <style name="Widget.SmarterTube.Mobile.ToolbarBackButton" parent="Widget.AppCompat.ImageButton">
        <item name="android:layout_width">56dp</item>
        <item name="android:layout_height">56dp</item>
        <item name="android:layout_gravity">center_vertical</item>
        <item name="android:layout_marginEnd">4dp</item>
        <item name="android:padding">16dp</item>
        <item name="android:src">@drawable/ic_shorts_back</item>
        <item name="android:tint">@color/mobile_text_primary</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="android:background">?android:attr/selectableItemBackgroundBorderless</item>
        <item name="android:contentDescription">@string/mobile_back</item>
    </style>

    <style name="Widget.SmarterTube.Mobile.ToolbarTitle" parent="android:Widget.TextView">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginEnd">16dp</item>
        <item name="android:singleLine">true</item>
        <item name="android:ellipsize">end</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:textColor">@color/mobile_text_primary</item>
        <item name="android:textSize">18sp</item>
    </style>
</resources>
